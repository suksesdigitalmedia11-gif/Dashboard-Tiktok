# === LOCAL DEVELOPMENT (SQLite) ===
# Leave all DB URLs empty → auto SQLite mode di data/finance.db
# DATABASE_URL=
# TURSO_URL=

# === PRODUCTION: Turso (RECOMMENDED — gratis, no egress limit) ===
# Sign up di https://turso.tech → create database → dapatkan URL + token
# TURSO_URL=libsql://your-db-org.turso.io
# TURSO_TOKEN=your-auth-token

# === PRODUCTION: Supabase PostgreSQL (legacy — kena egress limit) ===
# DATABASE_URL=postgresql://postgres:***@db.xxx.supabase.co:5432/postgres
# Atau Session Pooler:
# DATABASE_URL=postgresql://postgres.xxx:***@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# === TELEGRAM (Optional) ===
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
